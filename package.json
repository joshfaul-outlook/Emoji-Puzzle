{
  "name": "emoji-daily",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:storage": "azurite --silent --location .azurite",
    "dev:azure": "swa start http://localhost:3000 --api-location api",
    "build": "next build",
    "start": "npx serve out",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern api/dist",
    "api:build": "npm --prefix api run build",
    "api:test": "npm --prefix api test",
    "seed": "npm --prefix api run seed"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "emojibase-data": "17.0.0",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@azure/static-web-apps-cli": "2.0.10",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "azurite": "3.37.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
